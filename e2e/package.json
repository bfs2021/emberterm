{
  "name": "emberterm-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end tests for EmberTerm using WebdriverIO + tauri-driver",
  "type": "module",
  "scripts": {
    "test:e2e": "wdio run wdio.conf.ts",
    "test:e2e:ci": "TAURI_DRIVER_BINARY=$(which tauri-driver) wdio run wdio.conf.ts"
  },
  "devDependencies": {
    "@wdio/cli": "^9",
    "@wdio/local-runner": "^9",
    "@wdio/mocha-framework": "^9",
    "@wdio/spec-reporter": "^9",
    "ts-node": "^10",
    "typescript": "^5",
    "webdriverio": "^9"
  },
  "engines": {
    "node": ">=20"
  }
}

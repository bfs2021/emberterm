{
  "productName": "EmberTerm",
  "version": "0.1.0",
  "identifier": "dev.emberterm.app",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @emberterm/app dev",
    "beforeBuildCommand": "pnpm --filter @emberterm/app build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EmberTerm",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Agent-native terminal emulator",
    "longDescription": "EmberTerm is a lightweight, agent-native terminal emulator built with Tauri and Svelte. It implements OSC 7777, an open protocol for AI coding agent integration.",
    "copyright": "Copyright © 2026 EmberTerm Contributors",
    "license": "MIT",
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "providerShortName": null,
      "signingIdentity": null
    }
  }
}

{
  "productName": "EmberTerm",
  "identifier": "dev.emberterm.app",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @emberterm/app dev",
    "beforeBuildCommand": "pnpm --filter @emberterm/app build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EmberTerm",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREQUI3RkYwMTg0REQ4MjgKUldRbzJFMFk4SCtyM1RWTk11VXZ3cW15NDZHbjloQTJXT25nRStVTTlGa3NnM2R2UjVSMjFLUjAK",
      "endpoints": ["https://github.com/emberterm/emberterm/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A fast, simple terminal",
    "longDescription": "EmberTerm is a lightweight terminal for Windows: tabs with different shells (Git Bash, WSL, PowerShell), split panes, and your last session restored on reopen.",
    "copyright": "Copyright © 2026 EmberTerm Contributors",
    "license": "MIT",
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "providerShortName": null,
      "signingIdentity": "-"
    }
  }
}
